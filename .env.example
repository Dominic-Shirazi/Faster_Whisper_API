# Faster-Whisper Model Settings
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v1, large-v2, large-v3, distil-large-v2, distil-medium.en, distil-small.en, distil-large-v3
# I recommend small.en for speed and accuracy 
WHISPER_MODEL_SIZE=small.en
# Options: cpu, cuda, auto
# Chose CUDA if you have a nvidia graphics card or CPU if you don't
WHISPER_DEVICE=cuda

# Windows Service Configuration
# Whether to run the API as a background service (false) or visible console window (true)
API_VISIBLE=true

# How often to restart the background service to clear VRAM (in hours)
RESTART_INTERVAL_HOURS=4

# Client Configuration
# Where the background listener and file-transcriber send audio for transcription.
# Leave unset to use the local API. Point it at a remote whisper server to run the
# client on one machine and the API on another (e.g. a Tailscale 100.x address):
#   WHISPER_API_URL=http://100.x.y.z:5000/transcribe
# WHISPER_API_URL=http://127.0.0.1:5000/transcribe

# Startup delay for the listener to wait for API
LISTEN_DELAY_SECONDS=10

# How many minutes of inactivity before the background listener gracefully restarts itself
LISTENER_RESTART_INTERVAL_MINS=30

# When pasting into a Chrome Remote Desktop window, the listener nudges CRD's
# focus to force it to sync the clipboard to the remote machine, then waits this
# many seconds before sending Ctrl+V. Increase it on slow/laggy connections.
CRD_SYNC_DELAY_SECONDS=0.6

# Say 'prompt ai' while recording to give the a LLM instuctions on the requested transcription
# Local LLM API URL for Fast-Path processing
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
# Optional: run the base 'prompt ai' editor on a separate machine. Falls back to
# OLLAMA_API_URL when unset. If the API runs as a LocalSystem Windows service,
# use an IP (e.g. a Tailscale 100.x address), not a bare hostname, the service
# context often can't resolve short/MagicDNS names.
# OLLAMA_EDIT_API_URL=http://100.x.y.z:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Model for 'mean mode' (prompt roast / prompt tiktok / prompt disses).
# Needs an uncensored model that won't refuse. qwythos is a reasoning model, so
# the API strips its <think> block automatically. Pull it first:
#   ollama pull chatgpt1/qwythos-9b-claude-mythos-5-1m-abliterated
OLLAMA_ROAST_MODEL=chatgpt1/qwythos-9b-claude-mythos-5-1m-abliterated:latest
